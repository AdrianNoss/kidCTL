# Feature-Inbox (nur Betreiber von kidctl.de). Als ./feature-inbox.env neben docker-compose.yml ablegen (chmod 600).
# Eigene Datei statt .env: Server und Inbox sehen jeweils nur ihre eigenen Geheimnisse.

# IMAP (nur TLS, Port 993). Das Konto braucht Lesen, Flags setzen und Ordner anlegen/verschieben.
FEATURE_INBOX_IMAP_HOST=
FEATURE_INBOX_IMAP_PORT=993
FEATURE_INBOX_IMAP_USER=features@kidctl.de
FEATURE_INBOX_IMAP_PASSWORD=
# FEATURE_INBOX_IMAP_FOLDER=INBOX
# FEATURE_INBOX_IMAP_DONE=Verarbeitet
# FEATURE_INBOX_IMAP_UNSORTED=Unsortiert

# GitHub: Fine-grained Token, nur Repo AdrianNoss/kidCTL, nur „Issues: Read and write“ (Metadata: Read automatisch)
FEATURE_INBOX_GITHUB_REPO=AdrianNoss/kidCTL
FEATURE_INBOX_GITHUB_TOKEN=

# Aufbereitung: anthropic (Claude-API) oder none (nur parsen, keine Zusammenfassung)
FEATURE_INBOX_LLM=anthropic
FEATURE_INBOX_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# Abruf-Intervall in Minuten
FEATURE_INBOX_INTERVAL_MIN=15

# Tägliche Übersicht per Mail (leer = aus); Stunde in Ortszeit (TZ im Container: Europe/Berlin)
FEATURE_INBOX_REPORT_TO=
FEATURE_INBOX_REPORT_HOUR=7
FEATURE_INBOX_SMTP_HOST=
FEATURE_INBOX_SMTP_PORT=587
FEATURE_INBOX_SMTP_USER=
FEATURE_INBOX_SMTP_PASSWORD=
FEATURE_INBOX_SMTP_FROM=kidCTL Feature-Inbox <features@kidctl.de>
# starttls | ssl | none
FEATURE_INBOX_SMTP_SECURITY=starttls
