# Pflicht: zufälliger Schlüssel, z. B. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# ACHTUNG: Session-, Geräte-Token und Kopplungscodes werden mit SECRET_KEY gehasht –
# ein Wechsel macht alle Sessions und Geräte-Token ungültig (Geräte neu koppeln).
SECRET_KEY=
BASE_URL=https://kids.nossco.de
TOTP_ISSUER=kidctl
TZ_HOME=Europe/Berlin
# Nur lokal zur Entwicklung (erlaubt fehlenden SECRET_KEY, Cookies ohne Secure):
# KIDCTL_DEV=1
# KIDCTL_DATA_DIR=./data
# Erster Eltern-Account (optional statt interaktiv):
# KIDCTL_BOOTSTRAP_USER=
# KIDCTL_BOOTSTRAP_PASSWORD=
# Web Push (Benachrichtigungen aufs Handy). Schlüssel erzeugen:
#   docker compose run --rm kidctl python -m app.cli vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.org
