# Pflicht: zufälliger Schlüssel, z. B. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# ACHTUNG: Session-, Geräte-Token und Kopplungscodes werden mit SECRET_KEY gehasht –
# ein Wechsel macht alle Sessions und Geräte-Token ungültig (Geräte neu koppeln).
SECRET_KEY=
# Pflicht: Hauptschlüssel der Verschlüsselung (Daten je Familie). Erzeugen:
#   docker compose run --rm kidctl python -m app.cli master-key
# GETRENNT SICHERN (Passwortmanager) – ohne ihn sind alle verschlüsselten Daten verloren, auch in Backups.
KIDCTL_MASTER_KEY=
# Server-Umzug (optional): neue Adresse, auf die sich die Agenten selbst umstellen – nur wenn der neue Server
# ihr Geräte-Token anerkennt (gleiche Datenbank und gleicher SECRET_KEY). Erst nach dem Umzug setzen.
# KIDCTL_RELOCATE_TO=https://neu.example.org
# Datenbank (PostgreSQL-Container „db“). Nur Buchstaben/Ziffern/-/_ (steht in der Verbindungs-URL), z. B.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`. DATABASE_URL setzt docker-compose.yml daraus.
POSTGRES_PASSWORD=
BASE_URL=https://app.kidctl.de
# Betriebsart: single = eine Familie (Self-Hosting, Standard) | saas = viele Familien, Anmeldung nur per E-Mail
# KIDCTL_MODE=single
# Registrierung neuer Familien (nur saas): invite (Standard, mit Code aus /admin) | open | closed – braucht SMTP
# REGISTRATION=invite
# Abo (nur saas): Testphase neuer Familien in Tagen; Geheimnis für den Abo-Webhook (leer = aus)
# KIDCTL_TRIAL_DAYS=30
# BILLING_WEBHOOK_SECRET=
# Tickets (nur saas): Sammeladresse für Ticket-Hinweise; geschlossene Tickets nach Tagen löschen
# SUPPORT_NOTIFY_EMAIL=
# TICKET_RETENTION_DAYS=365
# Rechnungen: Steuermodus small_business (§ 19 UStG) | standard (19 % USt), Nummernformat, Zahlungsziel
# INVOICE_TAX_MODE=small_business
# INVOICE_NUMBER_FORMAT=RE-{YYYY}-{NNNN}
# INVOICE_DUE_DAYS=14
# Verwaltungsbereich /admin nur aus diesen Netzen (kommagetrennt, leer = überall; Accounts: app.cli create-operator)
# ADMIN_ALLOW_NETS=192.168.1.0/24
# Name in der Authenticator-App (leer: Name aus „Erscheinungsbild“, sonst KidCTL)
# TOTP_ISSUER=KidCTL
TZ_HOME=Europe/Berlin
# Nur lokal zur Entwicklung (erlaubt fehlenden SECRET_KEY, Cookies ohne Secure):
# KIDCTL_DEV=1
# KIDCTL_DATA_DIR=./data
# Erster Eltern-Account (optional statt interaktiv):
# KIDCTL_BOOTSTRAP_USER=
# KIDCTL_BOOTSTRAP_PASSWORD=
# Web Push (Benachrichtigungen aufs Handy). Schlüssel erzeugen:
#   docker compose run --rm kidctl python -m app.cli vapid-keys
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@example.org
# E-Mail für „Passwort vergessen“ und Hinweise bei Passwort-/Authenticator-Änderungen (optional).
# SMTP_SECURITY: starttls (meist Port 587), ssl (Port 465) oder none (nur im lokalen Netz).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=KidCTL <kidctl@example.org>
SMTP_SECURITY=starttls
# Sicherheitskontakt des Betreibers für /.well-known/security.txt (optional, wird vor dem Projektkontakt
# security@nossco.de genannt): E-Mail-Adresse oder https-URL
# SECURITY_CONTACT=security@example.org
# Quelltext des Servers (AGPL-3.0 §13) – bei eigenen Änderungen auf den eigenen Fork zeigen lassen
# SOURCE_URL=https://github.com/AdrianNoss/kidCTL
