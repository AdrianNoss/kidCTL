[Unit]
Description=kidctl DNS-Filter (Unbound) für Kind %i
Documentation=https://kids.nossco.de
After=network.target systemd-resolved.service
# Konfiguration erzeugt der kidctl-Agent unter /run/kidctl/dns/%i.conf

[Service]
ExecStart=/usr/bin/unbound -d -p -c /run/kidctl/dns/%i.conf
Restart=on-failure
RestartSec=2
DynamicUser=yes
# Logdatei der gesperrten Anfragen (liest und leert der Agent; liegt im RAM)
RuntimeDirectory=kidctl-dns/%i
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
