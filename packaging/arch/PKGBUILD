# Lokaler Build aus dem Repo: cd packaging/arch && makepkg
# (bei schreibgeschütztem Repo: BUILDDIR=/var/tmp/kb PKGDEST=/var/tmp/kb makepkg)
pkgname=kidctl
pkgver=0.1.0   # muss agent/kidctl_agent/__init__.py:__version__ entsprechen (Test prüft das)
pkgrel=1
pkgdesc="Parental Control für KDE Plasma – Agent (Bildschirmzeit, Login-Sperre)"
arch=(any)
url="https://kids.nossco.de"
license=(LicenseRef-kidctl)
depends=(
  python python-pydantic python-websockets python-dbus-next
  libnotify util-linux systemd pam sddm plasma-desktop
)
install=kidctl.install
source=(kidctl kidctl-agent.service)
sha256sums=(SKIP SKIP)  # lokale Dateien aus dem Repo

_root="$(realpath "$startdir/../..")"

package() {
  local lib="$pkgdir/usr/lib/kidctl"
  install -d "$lib"
  cp -r "$_root/agent/kidctl_agent" "$_root/common/kidctl_common" "$lib/"
  find "$lib" -name __pycache__ -prune -exec rm -rf {} +
  chmod -R u=rwX,go=rX "$lib"
  install -Dm755 "$_root/packaging/pam/kidctl-pam.sh" "$lib/kidctl-pam.sh"

  install -Dm755 "$srcdir/kidctl" "$pkgdir/usr/bin/kidctl"
  install -Dm644 "$srcdir/kidctl-agent.service" "$pkgdir/usr/lib/systemd/system/kidctl-agent.service"

  # SDDM-Theme (Breeze-Hülle mit Hinweisen der Login-Sperre)
  local theme="$pkgdir/usr/share/sddm/themes/kidctl"
  install -Dm644 -t "$theme" "$_root/packaging/sddm/theme/Main.qml" "$_root/packaging/sddm/theme/metadata.desktop"
  ln -s /usr/share/sddm/themes/breeze/theme.conf "$theme/theme.conf"
  install -Dm644 "$_root/packaging/sddm/zz-kidctl-theme.conf" "$pkgdir/etc/sddm.conf.d/zz-kidctl-theme.conf"
}
