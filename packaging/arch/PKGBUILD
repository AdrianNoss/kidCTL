# Lokaler Build aus dem Repo: cd packaging/arch && makepkg
# (bei schreibgeschütztem Repo: BUILDDIR=/var/tmp/kb PKGDEST=/var/tmp/kb makepkg)
# Split-Paket: kidctl (Agent, Tray, kidctl-Befehl) plus je Desktop kidctl-plasma bzw. kidctl-gnome.
pkgbase=kidctl
pkgname=(kidctl kidctl-plasma kidctl-gnome)
pkgver=0.27.0   # muss agent/kidctl_agent/__init__.py:__version__ entsprechen (Test prüft das)
pkgrel=1
pkgdesc="Parental Control für Arch Linux – Agent (Bildschirmzeit, Login-Sperre) und Tray-App"
arch=(any)
url="https://github.com/AdrianNoss/kidCTL"
license=(PolyForm-Noncommercial-1.0.0)
source=(kidctl kidctl-main.py kidctl-agent.service kidctl-tray kidctl-tray-main.py kidctl-tray.desktop
        base-programs.txt kidctl.svg)
sha256sums=(SKIP SKIP SKIP SKIP SKIP SKIP SKIP SKIP)  # lokale Dateien aus dem Repo

_root="$(realpath "$startdir/../..")"

package_kidctl() {
  depends=(
    python python-pydantic python-websockets python-dbus-next pyside6
    libnotify util-linux systemd pam unbound nftables
  )
  optdepends=('kidctl-plasma: für KDE Plasma (SDDM-Hinweis der Login-Sperre)'
              'kidctl-gnome: für GNOME (Tray-Symbol, Eintrag in der Anwendungsübersicht)')
  install=kidctl.install

  local lib="$pkgdir/usr/lib/kidctl"
  install -d "$lib"
  cp -r "$_root/agent/kidctl_agent" "$_root/common/kidctl_common" "$_root/tray/kidctl_tray" "$lib/"
  find "$lib" -name __pycache__ -prune -exec rm -rf {} +
  chmod -R u=rwX,go=rX "$lib"
  install -Dm755 "$_root/packaging/pam/kidctl-pam.sh" "$lib/kidctl-pam.sh"
  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm755 "$_root/packaging/mounts/kidctl-noexec.sh" "$lib/kidctl-noexec.sh"
  install -Dm644 "$_root/packaging/mounts/kidctl-noexec.service" "$pkgdir/usr/lib/systemd/system/kidctl-noexec.service"

  # Website-Filter: Resolver je Kind, NSS über Port 53, DoH in Browsern aus
  install -Dm644 "$_root/packaging/dns/kidctl-dns@.service" "$pkgdir/usr/lib/systemd/system/kidctl-dns@.service"
  install -Dm755 "$_root/packaging/dns/kidctl-nsswitch.sh" "$lib/kidctl-nsswitch.sh"
  install -Dm644 "$_root/packaging/dns/firefox-policies.json" "$pkgdir/etc/firefox/policies/policies.json"
  install -Dm644 "$_root/packaging/dns/chromium-policies.json" "$pkgdir/etc/chromium/policies/managed/kidctl.json"
  install -Dm644 "$srcdir/kidctl-main.py" "$lib/kidctl-main.py"
  install -Dm644 "$srcdir/kidctl-tray-main.py" "$lib/kidctl-tray-main.py"
  install -Dm644 "$srcdir/base-programs.txt" "$lib/base-programs.txt"

  install -Dm755 "$srcdir/kidctl" "$pkgdir/usr/bin/kidctl"
  install -Dm644 "$srcdir/kidctl-agent.service" "$pkgdir/usr/lib/systemd/system/kidctl-agent.service"

  # Tray-App: Autostart für alle User (zeigt sich nur bei zugeordneten Kindern)
  install -Dm755 "$srcdir/kidctl-tray" "$pkgdir/usr/bin/kidctl-tray"
  install -Dm644 "$srcdir/kidctl-tray.desktop" "$pkgdir/usr/share/applications/kidctl-tray.desktop"
  install -Dm644 "$srcdir/kidctl-tray.desktop" "$pkgdir/etc/xdg/autostart/kidctl-tray.desktop"
  install -Dm644 "$srcdir/kidctl.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/kidctl.svg"
}

package_kidctl-plasma() {
  pkgdesc="Parental Control – Anpassungen für KDE Plasma (SDDM-Theme mit Hinweis der Login-Sperre)"
  depends=("kidctl=$pkgver" sddm plasma-desktop)

  # Markierung für die Integritätsprüfung (Desktop-Paket installiert)
  install -Dm644 /dev/null "$pkgdir/usr/share/kidctl/desktop/plasma"
  # SDDM-Theme (Breeze-Hülle mit Hinweisen der Login-Sperre)
  local theme="$pkgdir/usr/share/sddm/themes/kidctl"
  install -Dm644 -t "$theme" "$_root/packaging/sddm/theme/Main.qml" "$_root/packaging/sddm/theme/metadata.desktop"
  ln -s /usr/share/sddm/themes/breeze/theme.conf "$theme/theme.conf"
  install -Dm644 "$_root/packaging/sddm/zz-kidctl-theme.conf" "$pkgdir/etc/sddm.conf.d/zz-kidctl-theme.conf"
}

package_kidctl-gnome() {
  pkgdesc="Parental Control – Anpassungen für GNOME (Tray-Symbol per AppIndicator, Eintrag „KidCTL“)"
  depends=("kidctl=$pkgver" gdm gnome-shell gnome-shell-extension-appindicator)

  install -Dm644 /dev/null "$pkgdir/usr/share/kidctl/desktop/gnome"
  # AppIndicator-Erweiterung als Voreinstellung für alle User (Schema-Override, pacman-Hook kompiliert)
  install -Dm644 "$_root/packaging/gnome/90_kidctl.gschema.override" \
    "$pkgdir/usr/share/glib-2.0/schemas/90_kidctl.gschema.override"
  # Eintrag in der Anwendungsübersicht (öffnet das Fenster der Tray-App)
  install -Dm644 "$_root/packaging/gnome/kidctl.desktop" "$pkgdir/usr/share/applications/kidctl.desktop"
}
